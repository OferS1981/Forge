# Copy to .env.local to turn accounts on. Both values are publishable: they are compiled into the
# page and are meant to be visible in a browser. Row level security is what protects the data, and
# packages/data/test/rls.test.ts proves it against real Postgres.
#
# With these unset, Forge runs entirely in the browser and every feature still works. See /account.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
