{
  "name": "@forge/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens and every control Forge draws itself.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "build": "echo 'ui: source is consumed directly by apps, nothing to build'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gallery": "vite --config gallery/vite.config.ts",
    "gallery:build": "vite build --config gallery/vite.config.ts",
    "gallery:preview": "vite preview --config gallery/vite.config.ts --port 4321 --strictPort"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
