{
  "name": "forge",
  "private": true,
  "version": "0.0.0",
  "description": "A prompt smithy. Production-grade prompts for a catalogue of AI models, each in that model's own grammar.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:golden": "vitest run --project catalog --dir packages/catalog/test/golden --passWithNoTests",
    "test:a11y": "playwright test --config playwright.config.ts --project a11y --pass-with-no-tests",
    "test:e2e": "playwright test --config playwright.config.ts --project smoke --pass-with-no-tests",
    "build": "turbo run build",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:golden && pnpm test:a11y && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
